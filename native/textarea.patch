 #[derive(Clone)]
+enum TextBuffer {
+    Plain(String),
+    Large(Rope),
+}
+
+impl TextBuffer {
+    fn new(value: String, large_file: bool) -> Self {
+        if large_file {
+            Self::Large(Rope::from_str(&value))
+        } else {
+            Self::Plain(value)
+        }
+    }
+
+    fn len(&self) -> usize {
+        match self {
+            Self::Plain(text) => text.len(),
+            Self::Large(rope) => rope.len_bytes(),
+        }
+    }
+
+    fn is_empty(&self) -> bool {
+        self.len() == 0
+    }
+
+    fn equals(&self, value: &str) -> bool {
+        match self {
+            Self::Plain(text) => text == value,
+            Self::Large(rope) => rope == value,
+        }
+    }
+
+    fn text(&self) -> Cow<'_, str> {
+        self.slice(0..self.len())
+    }
+
+    fn slice(&self, range: Range<usize>) -> Cow<'_, str> {
+        match self {
+            Self::Plain(text) => Cow::Borrowed(&text[range]),
+            Self::Large(rope) => {
+                let slice = rope.byte_slice(range);
+                match slice.as_str() {
+                    Some(text) => Cow::Borrowed(text),
+                    None => Cow::Owned(slice.to_string()),
+                }
+            }
+        }
+    }
+
+    fn replace(&mut self, range: Range<usize>, replacement: &str) {
+        match self {
+            Self::Plain(text) => text.replace_range(range, replacement),
+            Self::Large(rope) => {
+                let start = rope.byte_to_char(range.start);
+                let end = rope.byte_to_char(range.end);
+                rope.remove(start..end);
+                rope.insert(start, replacement);
+            }
+        }
+    }
+
+    fn line_range_at(&self, offset: usize) -> Range<usize> {
+        match self {
+            Self::Plain(text) => {
+                let start = text[..offset].rfind('\n').map_or(0, |i| i + 1);
+                let end = text[offset..].find('\n').map_or(text.len(), |i| offset + i);
+                start..end
+            }
+            Self::Large(rope) => {
+                let row = rope.byte_to_line(offset);
+                let start = rope.line_to_byte(row);
+                let end = if row + 1 < rope.len_lines() {
+                    rope.line_to_byte(row + 1) - 1
+                } else {
+                    rope.len_bytes()
+                };
+                start..end
+            }
+        }
+    }
+
+    fn visible_offset(&self, offset: usize) -> usize {
+        // A CRLF pair is one line break. GPUI splits on LF, so hit testing
+        // at the end of the painted row can otherwise land inside the pair.
+        if let Self::Large(rope) = self {
+            if offset > 0
+                && offset < rope.len_bytes()
+                && rope.byte(offset - 1) == b'\r'
+                && rope.byte(offset) == b'\n'
+            {
+                return offset - 1;
+            }
+        }
+        offset
+    }
+
+    fn grapheme_boundary(&self, offset: usize, forward: bool) -> usize {
+        let end = self.len();
+        let fallback = if forward { end } else { 0 };
+        if offset == fallback {
+            return fallback;
+        }
+        let mut cursor = GraphemeCursor::new(offset, end, true);
+        let boundary = |cursor: &mut GraphemeCursor, chunk, start| {
+            if forward {
+                cursor.next_boundary(chunk, start)
+            } else {
+                cursor.prev_boundary(chunk, start)
+            }
+        };
+        match self {
+            Self::Plain(text) => boundary(&mut cursor, text, 0)
+                .ok()
+                .flatten()
+                .unwrap_or(fallback),
+            Self::Large(rope) => {
+                let mut byte = if forward { offset } else { offset - 1 };
+                loop {
+                    let (chunk, start, _, _) = rope.chunk_at_byte(byte);
+                    match boundary(&mut cursor, chunk, start) {
+                        Ok(offset) => return offset.unwrap_or(fallback),
+                        Err(GraphemeIncomplete::PrevChunk) => byte = start - 1,
+                        Err(GraphemeIncomplete::NextChunk) => byte = start + chunk.len(),
+                        Err(GraphemeIncomplete::PreContext(end)) => {
+                            let (context, start, _, _) = rope.chunk_at_byte(end - 1);
+                            cursor.provide_context(&context[..end - start], start);
+                        }
+                        Err(GraphemeIncomplete::InvalidOffset) => return fallback,
+                    }
+                }
+            }
+        }
+    }
+}
