+
+impl EditorScrollbar {
+    fn grab_offset(&self, position: Point<Pixels>) -> Pixels {
+        let length = self.thumb.size.along(self.axis);
+        let offset = position.along(self.axis) - self.thumb.origin.along(self.axis);
+        if offset >= px(0.0) && offset <= length {
+            offset
+        } else {
+            length / 2.0
+        }
+    }
+
+    fn scroll_offset(&self, position: Point<Pixels>, grab_offset: Pixels) -> f32 {
+        let travel = self.track.size.along(self.axis) - self.thumb.size.along(self.axis);
+        let progress =
+            (position.along(self.axis) - self.track.origin.along(self.axis) - grab_offset) / travel;
+        progress.clamp(0.0, 1.0) * self.max_scroll
+    }
+
+    fn painted_track(&self) -> Bounds<Pixels> {
+        let cross = self.axis.invert();
+        Bounds::new(
+            self.track
+                .origin
+                .apply_along(cross, |_| self.thumb.origin.along(cross)),
+            self.track
+                .size
+                .apply_along(cross, |_| self.thumb.size.along(cross)),
+        )
+    }
+}
