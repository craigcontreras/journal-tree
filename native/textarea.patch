+    fn rope_caret_respects_graphemes_across_chunks() {
+        let text = "a👩‍💻🇵🇭é\r\n".repeat(512);
+        let rope = TextBuffer::new(text.clone(), true);
+        let TextBuffer::Large(chunks) = &rope else {
+            unreachable!()
+        };
+        let boundaries: Vec<_> = text
+            .grapheme_indices(true)
+            .map(|(i, _)| i)
+            .chain(std::iter::once(text.len()))
+            .collect();
+        let mut offset = 0;
+        for chunk in chunks.chunks() {
+            for i in text[offset..offset + chunk.len()]
+                .char_indices()
+                .map(|(i, _)| offset + i)
+            {
+                let before = boundaries.partition_point(|&boundary| boundary < i);
+                let after = boundaries.partition_point(|&boundary| boundary <= i);
+                assert_eq!(
+                    rope.grapheme_boundary(i, false),
+                    boundaries[before.saturating_sub(1)],
+                    "before {i}"
+                );
+                assert_eq!(
+                    rope.grapheme_boundary(i, true),
+                    boundaries[after],
+                    "after {i}"
+                );
+            }
+            offset += chunk.len();
+        }
+    }
